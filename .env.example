# Public address shared by the website, API, and mobile app.
PSST_DOMAIN=transfer.example.com
PUBLIC_URL=https://transfer.example.com

# Required on first startup only. Choose a unique password (12–72 UTF-8 bytes).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Keep false for normal deployments. Local development HTTP requires explicit opt-in.
AUTH_ALLOW_INSECURE_HTTP=false

# Public receive links have bounded storage and upload counts.
MAX_SLOT_TRANSFERS=20
MAX_SLOT_SIZE=5368709120
MAX_SLOT_EXPIRY=168h
