# Copy to a protected operator-owned release.env; never commit the real file.
# Obtain exact image references from the verified release manifest.
# Leave blank until selecting a published release (floating tags are unsupported).
BACKEND_IMAGE=
WEB_IMAGE=

# Stable Compose identity and operator-configurable public address.
COMPOSE_PROJECT_NAME=psst-zip
PSST_DOMAIN=transfer.example.com
PUBLIC_URL=https://transfer.example.com
AUTH_ALLOW_INSECURE_HTTP=false

# Fresh installation only: enter credentials directly on the server, then remove
# ADMIN_PASSWORD after the initial account has been created. Updates leave blank.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional storage retention overrides; inspect existing containers first.
# BACKEND_DATA_VOLUME=your-existing-backend-volume
# DB_PATH=/app/data/your-existing-database.db
# CADDY_DATA_VOLUME=your-existing-caddy-data-volume
# CADDY_CONFIG_VOLUME=your-existing-caddy-config-volume
# EXTERNAL_PROXY_DATA_VOLUME=your-existing-gateway-data-volume
# EXTERNAL_PROXY_CONFIG_VOLUME=your-existing-gateway-config-volume

# Receive links keep the same bounded defaults as the source installation.
MAX_SLOT_TRANSFERS=20
MAX_SLOT_SIZE=5368709120
MAX_SLOT_EXPIRY=168h
