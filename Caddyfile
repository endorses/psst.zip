{
	http_port {$CADDY_HTTP_PORT:80}
	https_port {$CADDY_HTTPS_PORT:443}
}

{$PSST_DOMAIN::80} {
	# Protect login and pairing pages as well as API responses.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		# Script hashes are emitted in the static HTML by SvelteKit. Frame
		# ancestry needs an HTTP header because browsers ignore it in meta CSP.
		Content-Security-Policy "frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
	}

	# The authenticated workspace scanner runs only in the root document.
	@workspace path / /index.html
	@otherDocuments not path / /index.html
	header @otherDocuments Permissions-Policy "camera=(), microphone=(), geolocation=()"
	header @workspace Permissions-Policy "camera=(self), microphone=(), geolocation=()"

	# API requests go to the backend
	handle /api/* {
		reverse_proxy backend:8080
	}

	# Serve the web app static files
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
